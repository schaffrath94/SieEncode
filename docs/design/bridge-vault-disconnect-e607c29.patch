+                    Assert.Equal(SecureKeyFailureReason.ProviderUnavailable, resolution.FailureReason);
+                    host.ExecutionHost.Result = host.ExecutionHost.Result with { Outcome = ExecutionOutcome.Failure };
+                }
+                finally { gate.TrySetResult(true); }
+            }
+            Task? resolutionTask = null;
