+            await resolutionTask!.WaitAsync(TimeSpan.FromSeconds(10));
+            var second = await ConnectAsync(pipe);
+            var resumed = await second.ResumeAsync("synthetic-disconnect").WaitAsync(TimeSpan.FromSeconds(10));
+            Assert.Equal("synthetic-disconnect", resumed.Result!.RequestId);
+            Assert.Equal(RunStatuses.Failure, resumed.Result.Status);
+            Assert.Single(host.ExecutionHost.Requests);
+        }
