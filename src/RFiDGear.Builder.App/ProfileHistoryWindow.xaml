<Window x:Class="RFiDGear.Builder.App.ProfileHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profilhistorie · SieEncode Studio" Icon="assets/branding/SieEncode.ico" Height="760" Width="1260" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Profilhistorie" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="HistoryIntro" Text="Archivierte Profilstände werden schreibgeschützt geprüft und mit dem aktuellen Stand verglichen." Foreground="#526B70" TextWrapping="Wrap" Margin="0,4,0,10"/>
    </StackPanel>
    <GroupBox Grid.Row="1" Header="Versionen">
      <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="HistoryGrid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Stand" Binding="{Binding State}" Width="100"/>
          <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120"/>
          <DataGridTextColumn Header="Geändert" Binding="{Binding Modified}" Width="170"/>
          <DataGridTextColumn Header="SHA-256" Binding="{Binding Digest}" Width="130"/>
          <DataGridTextColumn Header="Integrität" Binding="{Binding Integrity}" Width="130"/>
          <DataGridTextColumn Header="Datei / Befund" Binding="{Binding Source}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </GroupBox>
    <GroupBox Grid.Row="2" Header="Fachlicher Vergleich: gewählter Historienstand → aktueller Stand">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="DiffSummary" Text="Bitte einen Historienstand auswählen." TextWrapping="Wrap" Margin="4"/>
        <DataGrid x:Name="DiffGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Änderung" Binding="{Binding Change}" Width="90"/>
            <DataGridTextColumn Header="Bereich" Binding="{Binding Scope}" Width="110"/>
            <DataGridTextColumn Header="Ziel" Binding="{Binding Target}" Width="1.4*"/>
            <DataGridTextColumn Header="Eigenschaft" Binding="{Binding Property}" Width="1.2*"/>
            <DataGridTextColumn Header="Historie" Binding="{Binding Left}" Width="1.5*"/>
            <DataGridTextColumn Header="Aktuell" Binding="{Binding Right}" Width="1.5*"/>
            <DataGridTextColumn Header="Wirkung" Binding="{Binding Impact}" Width="1.4*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </GroupBox>
    <Border Grid.Row="3" Background="#FFF8E1" BorderBrush="#D9B44A" BorderThickness="1" CornerRadius="4" Padding="10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Wiederherstellung überschreibt keinen Historienstand. Der gewählte Inhalt wird als neue eindeutige Profilversion gespeichert; der derzeit aktuelle Stand wird zuvor ebenfalls archiviert." TextWrapping="Wrap" VerticalAlignment="Center"/>
        <TextBox x:Name="NewVersion" Grid.Column="1" ToolTip="Neue eindeutige Versionsnummer, z. B. 2.1"/>
        <Button x:Name="RestoreButton" Grid.Column="2" Content="Als neue Version wiederherstellen" Click="Restore_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
        <Button Grid.Column="3" Content="Schließen" Click="Close_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
