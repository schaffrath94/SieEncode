            </StackPanel></GroupBox>
            <GroupBox Header="RFiDGear-Integration"><StackPanel><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Runtime" VerticalAlignment="Center"/><TextBox x:Name="RFiDGearExecutableText" Grid.Column="1"/><Button Grid.Column="2" Content="Datei wählen" Click="BrowseRFiDGear_Click"/><TextBlock x:Name="RFiDGearVersionText" Grid.Column="1" Grid.Row="1" Foreground="#526B70" Margin="7,2"/><TextBlock x:Name="RFiDGearReaderText" Grid.Column="1" Grid.Row="2" Foreground="#526B70" Margin="7,2" TextWrapping="Wrap"/><TextBlock x:Name="RFiDGearEvidenceText" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" Foreground="#607D86" Margin="7,2" TextWrapping="Wrap"/></Grid><WrapPanel><Button x:Name="UseBundledRuntimeButton" Content="Gebündelte SieEncode Runtime verwenden" Click="UseBundledRuntime_Click" ToolTip="Übernimmt die mit diesem Installer gelieferte Runtime. Anschließend Einstellungen speichern."/></WrapPanel><Expander x:Name="SettingsCapabilityDetails" Header="Technische Fähigkeitsmatrix · Experten" Margin="4,8,4,0"><StackPanel><TextBlock Text="Funktionen werden nur bei positivem Binärnachweis freigegeben; die Versionsnummer allein genügt nicht." Margin="4,6,4,5" TextWrapping="Wrap"/><DataGrid x:Name="RFiDGearCapabilitiesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="270"><DataGrid.Columns><DataGridTextColumn Header="Fähigkeit" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Nachweis" Binding="{Binding Evidence}" Width="3*"/></DataGrid.Columns></DataGrid></StackPanel></Expander></StackPanel></GroupBox>
