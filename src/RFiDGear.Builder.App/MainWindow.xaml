          <StackPanel Grid.Row="0"><TextBlock Text="Der keywertfreie Sollplan wird ausschließlich gegen vorhandene finale Readbacks ausgewertet. Bytegenaue Datenvergleiche, operative Authentisierungsnachweise und Punkte ohne Istwert werden getrennt ausgewiesen. Fehlende Metadaten bleiben sichtbar ‚Nicht prüfbar‘." Foreground="#526B70" Margin="0,5,0,12" TextWrapping="Wrap"/></StackPanel>
          <GroupBox Grid.Row="1" Header="Projekt"><StackPanel><TextBlock x:Name="AcceptanceProject" Text="Kein Projekt ausgewählt" FontSize="18"/><TextBlock x:Name="AcceptancePath" Text="–" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6"/><WrapPanel><Button Content="Projekt auswählen" Tag="Projects" Click="Navigate_Click"/><Button Content="Projekt prüfen" Click="Preflight_Click"/><Button x:Name="AcceptanceRunButton" Content="Prüfbericht erzeugen" Click="RunAcceptance_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}"/></WrapPanel></StackPanel></GroupBox>
