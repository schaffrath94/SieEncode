<Window x:Class="RFiDGear.Builder.App.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SieEncode – Hilfe &amp; Tour" Icon="assets/branding/SieEncode.ico" Width="920" Height="610" MinWidth="780" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="SieEncode kennenlernen" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Die Tour erklärt den normalen Arbeitsweg und trennt sichere Prüfungen von schreibenden Kartenaktionen." Foreground="#526B70" Margin="0,6,0,16" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="StepsList" DisplayMemberPath="Title" SelectionChanged="StepsList_SelectionChanged" Margin="0,0,16,0"/>
      <Border Grid.Column="1" Background="White" BorderBrush="#CCD7DA" BorderThickness="1" CornerRadius="4" Padding="24">
        <StackPanel><TextBlock x:Name="StepNumber" Foreground="#0B6871" FontWeight="SemiBold"/><TextBlock x:Name="StepTitle" FontSize="23" FontWeight="SemiBold" Margin="0,8"/><TextBlock x:Name="StepBody" TextWrapping="Wrap" FontSize="14" LineHeight="22"/><Border Background="#FFF8E1" BorderBrush="#D9B44A" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,18,0,0"><TextBlock x:Name="StepSafety" TextWrapping="Wrap"/></Border><Button x:Name="OpenAreaButton" Content="Diesen Bereich öffnen" Click="OpenArea_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"/></StackPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tipp: Hilfe &amp; Tour bleibt jederzeit oben rechts erreichbar." VerticalAlignment="Center" Foreground="#526B70"/><Button Grid.Column="1" x:Name="PreviousButton" Content="Zurück" Click="Previous_Click"/><Button Grid.Column="2" x:Name="NextButton" Content="Weiter" Click="Next_Click" Style="{StaticResource PrimaryButton}"/><Button Grid.Column="3" Content="Schließen" IsCancel="True"/></Grid>
  </Grid>
</Window>
