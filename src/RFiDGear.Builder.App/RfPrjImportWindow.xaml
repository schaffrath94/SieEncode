<Window x:Class="RFiDGear.Builder.App.RfPrjImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rfPrj-Profilimport · SieEncode Studio" Icon="assets/branding/SieEncode.ico" Height="820" Width="1320" MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Bestehendes RFiDGear-Projekt als Profilvorschlag analysieren" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="Die rfPrj-Datei wird nur gelesen. Schlüsselwerte und Schreibdaten werden nicht übernommen. Nicht sicher rekonstruierbare Kodierrezepte bleiben bewusst leer." Foreground="#526B70" TextWrapping="Wrap" Margin="0,4,0,6"/>
      <TextBlock x:Name="ImportSource" FontFamily="Consolas" TextWrapping="Wrap"/>
      <TextBlock x:Name="ImportSummary" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4"/>
    </StackPanel>
    <GroupBox Grid.Row="1" Header="Erkannte Applications – Auswahl für den Entwurf">
      <DataGrid x:Name="ApplicationsGrid" AutoGenerateColumns="False" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="Übernehmen" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
          <DataGridTextColumn Header="AID" Binding="{Binding Aid}" IsReadOnly="True" Width="90"/>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="1.5*"/>
          <DataGridTextColumn Header="Keys" Binding="{Binding Keys}" IsReadOnly="True" Width="130"/>
          <DataGridTextColumn Header="Files" Binding="{Binding Files}" IsReadOnly="True" Width="70"/>
          <DataGridTextColumn Header="Evidenz" Binding="{Binding Confidence}" IsReadOnly="True" Width="120"/>
          <DataGridTextColumn Header="Profilabgleich" Binding="{Binding ExistingProfile}" IsReadOnly="True" Width="2*"/>
          <DataGridTextColumn Header="Quell-Tasks" Binding="{Binding SourceTasks}" IsReadOnly="True" Width="90"/>
        </DataGrid.Columns>
      </DataGrid>
    </GroupBox>
    <GroupBox Grid.Row="2" Header="Befunde und Grenzen">
      <DataGrid x:Name="IssuesGrid" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Stufe" Binding="{Binding Severity}" Width="90"/>
          <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="190"/>
          <DataGridTextColumn Header="AID" Binding="{Binding Aid}" Width="90"/>
          <DataGridTextColumn Header="File" Binding="{Binding FileId}" Width="60"/>
          <DataGridTextColumn Header="Befund" Binding="{Binding Message}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </GroupBox>
    <GroupBox Grid.Row="3" Header="Metadaten des noch ungespeicherten Kundenprofil-Entwurfs">
      <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Profil-ID" VerticalAlignment="Center"/><TextBox x:Name="ProposalId" Grid.Column="1"/>
        <TextBlock Text="Code" Grid.Column="2" VerticalAlignment="Center"/><TextBox x:Name="ProposalCode" Grid.Column="3"/>
        <TextBlock Text="Version" Grid.Column="4" VerticalAlignment="Center"/><TextBox x:Name="ProposalVersion" Grid.Column="5"/>
        <TextBlock Text="Name" Grid.Row="1" VerticalAlignment="Center"/><TextBox x:Name="ProposalName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"/>
      </Grid>
    </GroupBox>
    <Border Grid.Row="4" Background="#F7F9FA" BorderBrush="#C9D1D4" BorderThickness="1" CornerRadius="4" Padding="8">
      <DockPanel><Button DockPanel.Dock="Left" Content="Importbericht öffnen" Click="OpenReport_Click"/><CheckBox x:Name="ReviewAcknowledgement" DockPanel.Dock="Left" Content="Befunde gelesen; fehlende Kodierrezepte werden im Profil-Editor bewusst geprüft" VerticalAlignment="Center" Margin="12,0" Checked="ReviewAcknowledgement_Changed" Unchecked="ReviewAcknowledgement_Changed"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="CreateProposalButton" Content="Auswahl im Profil-Editor prüfen" Click="CreateProposal_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Abbrechen" Click="Close_Click"/></WrapPanel></DockPanel>
    </Border>
  </Grid>
</Window>
