<Window x:Class="RFiDGear.Builder.App.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profil bearbeiten · SieEncode Studio" Icon="assets/branding/SieEncode.ico" Height="880" Width="1220" MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="EditorHeading" Text="Profil bearbeiten" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Änderungen werden erst nach vollständiger Profilvalidierung dauerhaft gespeichert. Schlüsselwerte gehören nicht in ein Profil." Foreground="#526B70" Margin="0,4,0,10"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Profil-ID" VerticalAlignment="Center"/><TextBox x:Name="ProfileId" Grid.Column="1" TextChanged="Dirty_TextChanged"/>
        <TextBlock Text="Code" Grid.Column="2" VerticalAlignment="Center"/><TextBox x:Name="ProfileCode" Grid.Column="3" TextChanged="Dirty_TextChanged"/>
        <TextBlock Text="Version" Grid.Column="4" VerticalAlignment="Center"/><TextBox x:Name="ProfileVersion" Grid.Column="5" TextChanged="Dirty_TextChanged"/>
        <TextBlock Text="Name" Grid.Row="1" VerticalAlignment="Center"/><TextBox x:Name="ProfileName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" TextChanged="Dirty_TextChanged"/>
        <TextBlock Text="Beschreibung" Grid.Row="2" VerticalAlignment="Center"/><TextBox x:Name="ProfileDescription" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" TextChanged="Dirty_TextChanged"/>
      </Grid>
      <TextBlock x:Name="ProfileHistoryText" Text="Profilhistorie wird beim Speichern versionierter Änderungen geführt." Foreground="#526B70" TextWrapping="Wrap" Margin="0,7,0,0"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock x:Name="ValidationText" Text="Noch nicht geprüft." TextWrapping="Wrap" Foreground="#526B70" Margin="4,0,4,6"/>
      <WrapPanel HorizontalAlignment="Right"><Button Content="Prüfen" Click="Validate_Click"/><Button Content="Speichern" Click="Save_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Schließen" Click="Close_Click"/></WrapPanel>
    </StackPanel>

    <TabControl Margin="0,12,0,0">
      <TabItem Header="Variablen">
        <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
          <StackPanel><WrapPanel><Button Content="Neu" Click="NewVariable_Click"/><Button Content="Löschen" Click="DeleteVariable_Click"/></WrapPanel><DataGrid x:Name="VariablesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="VariableSelectionChanged" MinHeight="380"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="Bezeichnung" Binding="{Binding Label}" Width="1.5*"/><DataGridTextColumn Header="Bereich" Binding="{Binding Scope}" Width="*"/><DataGridTextColumn Header="Datentyp" Binding="{Binding Type}" Width="*"/><DataGridCheckBoxColumn Header="Pflicht" Binding="{Binding Required}" Width="70"/></DataGrid.Columns></DataGrid></StackPanel>
          <GroupBox Grid.Column="1" Header="Variable" Margin="10,0,0,0"><StackPanel>
            <TextBlock Text="ID"/><TextBox x:Name="VariableId"/><TextBlock Text="Bezeichnung"/><TextBox x:Name="VariableLabel"/>
            <TextBlock Text="Bereich"/><ComboBox x:Name="VariableScope"><ComboBoxItem Content="project"/><ComboBoxItem Content="card"/></ComboBox>
            <TextBlock Text="Datentyp"/><ComboBox x:Name="VariableType"><ComboBoxItem Content="Ziffern" Tag="digits"/><ComboBoxItem Content="Text" Tag="text"/><ComboBoxItem Content="HEX-Bytes" Tag="hex"/></ComboBox>
            <TextBlock Text="Längenregel: exakt ODER erlaubte Werte ODER Min/Max" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Exakt"/><TextBox x:Name="VariableLength"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Erlaubt, z.B. 6,8"/><TextBox x:Name="VariableAllowed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Min"/><TextBox x:Name="VariableMin"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Max"/><TextBox x:Name="VariableMax"/></StackPanel></Grid>
            <TextBlock Text="Standardwert"/><TextBox x:Name="VariableDefault"/><CheckBox x:Name="VariableRequired" Content="Pflichtfeld" Margin="0,7"/>
            <Button Content="Variable übernehmen" Click="ApplyVariable_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
          </StackPanel></GroupBox>
        </Grid>
      </TabItem>

      <TabItem Header="Applications und Dateien">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
          <WrapPanel><Button Content="Application neu" Click="NewApplication_Click"/><Button Content="Application löschen" Click="DeleteApplication_Click"/></WrapPanel>
          <DataGrid x:Name="ApplicationsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="ApplicationSelectionChanged" Height="150"><DataGrid.Columns><DataGridTextColumn Header="AID" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Keytyp" Binding="{Binding KeyType}" Width="*"/><DataGridTextColumn Header="Keys" Binding="{Binding KeyCount}" Width="70"/></DataGrid.Columns></DataGrid>
          <GroupBox Header="Application"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="AID (6 Hex)"/><TextBox x:Name="ApplicationId"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Name"/><TextBox x:Name="ApplicationName"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Keytyp"/><ComboBox x:Name="ApplicationKeyType"><ComboBoxItem Content="DF_KEY_DES"/><ComboBoxItem Content="DF_KEY_AES"/><ComboBoxItem Content="DF_KEY_3K3DES"/></ComboBox></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Keyanzahl 1..14"/><TextBox x:Name="ApplicationKeyCount"/></StackPanel>
            <StackPanel Grid.Row="1"><TextBlock Text="Key-Wechsel"/><ComboBox x:Name="ApplicationChangeMode"><ComboBoxItem Content="ChangeKeyUsingMK"/><ComboBoxItem Content="ChangeKeyUsingKeyNo"/></ComboBox></StackPanel>
            <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="Transport-KeySettings (Bits 0..3)"><WrapPanel><CheckBox x:Name="TransportChange" Content="Masterkey ändern"/><CheckBox x:Name="TransportList" Content="Applications listen"/><CheckBox x:Name="TransportCreate" Content="Erstellen/Löschen"/><CheckBox x:Name="TransportConfig" Content="Konfiguration ändern"/></WrapPanel></GroupBox>
            <GroupBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Header="Produktiv-KeySettings (Bits 0..3)"><WrapPanel><CheckBox x:Name="ProductiveChange" Content="Masterkey ändern"/><CheckBox x:Name="ProductiveList" Content="Applications listen"/><CheckBox x:Name="ProductiveCreate" Content="Erstellen/Löschen"/><CheckBox x:Name="ProductiveConfig" Content="Konfiguration ändern"/></WrapPanel></GroupBox>
            <Button Grid.Row="3" Grid.ColumnSpan="4" Content="Application übernehmen" Click="ApplyApplication_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
          </Grid></GroupBox>

          <Separator Margin="0,8"/><WrapPanel><TextBlock Text="Dateien der ausgewählten Application" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Datei neu" Click="NewFile_Click"/><Button Content="Datei löschen" Click="DeleteFile_Click"/></WrapPanel>
          <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="FileSelectionChanged" Height="150"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="Bytes" Binding="{Binding Size}" Width="70"/><DataGridTextColumn Header="Kommunikation" Binding="{Binding Communication}" Width="*"/></DataGrid.Columns></DataGrid>
          <GroupBox Header="Datei"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ID 0..31"/><TextBox x:Name="FileId"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Name"/><TextBox x:Name="FileNameText"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Typ"/><ComboBox x:Name="FileType" SelectionChanged="FileSettingsPreviewChanged"><ComboBoxItem Content="StdDataFile"/><ComboBoxItem Content="BackupFile"/></ComboBox></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Größe"/><TextBox x:Name="FileSize"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Finale Kommunikation"/><ComboBox x:Name="FileCommunication" SelectionChanged="FileSettingsPreviewChanged"><ComboBoxItem Content="CM_PLAIN"/><ComboBoxItem Content="CM_MAC"/><ComboBoxItem Content="CM_ENCRYPT"/></ComboBox></StackPanel></Grid>
            <GroupBox Header="Finaler Kartenzustand"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Lesen mit Key"/><TextBox x:Name="FileRead" TextChanged="FileSettingsPreviewChanged"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Schreiben mit Key"/><TextBox x:Name="FileWrite" TextChanged="FileSettingsPreviewChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Lesen/Schreiben mit Key"/><TextBox x:Name="FileReadWrite" TextChanged="FileSettingsPreviewChanged"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Settings ändern mit Key"/><TextBox x:Name="FileChange" TextChanged="FileSettingsPreviewChanged"/></StackPanel></Grid></GroupBox>
            <CheckBox x:Name="FileHasCreation" Content="Abweichende initiale FileSettings für Mastering verwenden (erzeugt ChangeFileSettings)" Margin="0,7" Checked="FileHasCreationChanged" Unchecked="FileHasCreationChanged"/>
            <StackPanel x:Name="CreationSettingsPanel"><WrapPanel><Button Content="Finale Einstellungen als Ausgangspunkt übernehmen" Click="CopyFinalToCreation_Click"/><TextBlock Text="Danach nur die für das Mastering nötigen Abweichungen ändern." Foreground="#526B70" VerticalAlignment="Center" Margin="8,0"/></WrapPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Initiale Kommunikation"/><ComboBox x:Name="CreationCommunication" SelectionChanged="FileSettingsPreviewChanged"><ComboBoxItem Content="CM_PLAIN"/><ComboBoxItem Content="CM_MAC"/><ComboBoxItem Content="CM_ENCRYPT"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Initial Lesen"/><TextBox x:Name="CreationRead" TextChanged="FileSettingsPreviewChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Initial Schreiben"/><TextBox x:Name="CreationWrite" TextChanged="FileSettingsPreviewChanged"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Initial L/S"/><TextBox x:Name="CreationReadWrite" TextChanged="FileSettingsPreviewChanged"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Initial Ändern"/><TextBox x:Name="CreationChange" TextChanged="FileSettingsPreviewChanged"/></StackPanel></Grid></StackPanel>
            <Border Background="#F7F9FA" BorderBrush="#C9D1D4" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,7"><StackPanel><TextBlock Text="Auswirkung im Mastering" FontWeight="SemiBold"/><TextBlock x:Name="FileSettingsPreview" Text="Datei auswählen, um Initial-/Endzustand zu erklären." TextWrapping="Wrap"/><TextBlock x:Name="FileSettingsSequence" Foreground="#526B70" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
            <WrapPanel><CheckBox x:Name="FileZeroFill" Content="Beim Mastering mit Nullen initialisieren" Checked="FileSettingsPreviewChanged" Unchecked="FileSettingsPreviewChanged"/><TextBlock Text="Kodier-Ausgabe" VerticalAlignment="Center" Margin="20,0,4,0"/><TextBox x:Name="FileCodingOutput" Width="220" ToolTip="Logischer Ausgabename, z.B. Personalnummer"/></WrapPanel>
            <Button Content="Datei übernehmen" Click="ApplyFile_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
          </StackPanel></GroupBox>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Kodierrezept">
        <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="RecipeContext" Text="Zuerst Application und Datei im vorherigen Reiter auswählen." FontWeight="SemiBold" Margin="0,0,0,6"/><WrapPanel><Button Content="Baustein neu" Click="NewRecipe_Click"/><Button Content="Löschen" Click="DeleteRecipe_Click"/><Button Content="Nach oben" Click="RecipeUp_Click"/><Button Content="Nach unten" Click="RecipeDown_Click"/></WrapPanel><DataGrid x:Name="RecipeGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="RecipeSelectionChanged" Height="285"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Position}" Width="40"/><DataGridTextColumn Header="Datenformat" Binding="{Binding Format}" Width="1.5*"/><DataGridTextColumn Header="Quelle / Inhalt" Binding="{Binding SourceOrValue}" Width="1.4*"/><DataGridTextColumn Header="Bytes" Binding="{Binding ByteWidth}" Width="60"/></DataGrid.Columns></DataGrid><TextBlock Text="Bytevorschau · Beispieldaten, keine Schlüssel" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBox x:Name="RecipeBytePreview" IsReadOnly="True" FontFamily="Consolas" FontSize="12" MinHeight="105" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></StackPanel>
          <GroupBox Grid.Column="1" Header="Rezeptbaustein" Margin="10,0,0,0"><StackPanel><TextBlock Text="Datenformat"/><ComboBox x:Name="RecipeOperation" SelectionChanged="RecipeOperationChanged"><ComboBoxItem Content="HEX-Konstante" Tag="fixedHex"/><ComboBoxItem Content="Klartext-Konstante (ASCII)" Tag="fixedAscii"/><ComboBoxItem Content="Text-Konstante (UTF-8)" Tag="fixedUtf8"/><ComboBoxItem Content="HEX-Bytes aus Variable" Tag="hexBytes"/><ComboBoxItem Content="Klartext aus Variable (ASCII)" Tag="asciiText"/><ComboBoxItem Content="Text aus Variable (UTF-8)" Tag="utf8Text"/><ComboBoxItem Content="Ziffern als ASCII" Tag="asciiDigits"/><ComboBoxItem Content="Ziffern als BCD" Tag="bcdDigits"/><ComboBoxItem Content="Ganzzahl · Big-Endian" Tag="uintBigEndian"/><ComboBoxItem Content="Ganzzahl · Little-Endian" Tag="uintLittleEndian"/><ComboBoxItem Content="Mit 00 bis Dateigröße auffüllen" Tag="zeroPadToFileSize"/><ComboBoxItem Content="Mit Byte bis Dateigröße auffüllen" Tag="padToFileSize"/></ComboBox><TextBlock x:Name="RecipeOperationHelp" Text="Format wählen; nur die dafür relevanten Felder werden ausgewertet." Foreground="#526B70" TextWrapping="Wrap" Margin="0,3,0,6"/><TextBlock Text="Variable (bei variablen Bausteinen)"/><ComboBox x:Name="RecipeSource" DisplayMemberPath="Id" SelectedValuePath="Id"/><TextBlock Text="Konstanter Inhalt / Padding-Byte"/><TextBox x:Name="RecipeValue" ToolTip="HEX ohne 0x, Klartext direkt, Padding als genau ein Byte 00..FF"/><TextBlock Text="Ausgabebreite in Byte"/><TextBox x:Name="RecipeWidth"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Links auffüllen (HEX-Byte)"/><TextBox x:Name="RecipePadLeft"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Rechts auffüllen (HEX-Byte)"/><TextBox x:Name="RecipePadRight"/></StackPanel></Grid><Button Content="Baustein übernehmen" Click="ApplyRecipe_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></GroupBox>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
